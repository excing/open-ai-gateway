# Copy this file to `.dev.vars`, then replace all placeholder keys.
# Wrangler reads `.dev.vars` as dotenv format, so backticks can wrap multiline JSON.
ADMIN_KEY=replace-with-admin-key
GATEWAY_CONFIG_JSON=`
{
  "channels": [
    {
      "name": "OpenAI Main",
      "key": "openai-main",
      "provider": "openai",
      "apiKey": "replace-with-openai-key",
      "baseURL": "https://api.openai.com/v1",
      "models": ["gpt-4o-mini", "gpt-4.1-mini"],
      "headers": {}
    },
    {
      "name": "Groq GPT-4o Mini",
      "key": "groq-gpt4o-mini",
      "provider": "openai",
      "apiKey": "replace-with-groq-key",
      "baseURL": "https://api.groq.com/openai/v1",
      "models": ["gpt-4o-mini"],
      "headers": {}
    },
    {
      "name": "Google Gemini",
      "key": "google-gemini",
      "provider": "google",
      "apiKey": "replace-with-google-key",
      "baseURL": "https://generativelanguage.googleapis.com/v1beta",
      "models": ["gemini-2.5-flash"],
      "headers": {}
    },
    {
      "name": "Anthropic Claude",
      "key": "anthropic-claude",
      "provider": "anthropic",
      "apiKey": "replace-with-anthropic-key",
      "baseURL": "https://api.anthropic.com/v1",
      "models": ["claude-3-5-sonnet-latest"],
      "headers": {}
    },
    {
      "name": "OpenRouter",
      "key": "openrouter",
      "provider": "openrouter",
      "apiKey": "replace-with-openrouter-key",
      "baseURL": "https://openrouter.ai/api/v1",
      "models": ["openai/gpt-4o-mini"],
      "headers": {}
    },
    {
      "name": "Pollinations",
      "key": "pollinations",
      "provider": "pollinations",
      "apiKey": "replace-with-pollinations-key",
      "baseURL": "https://text.pollinations.ai/openai",
      "models": ["openai"],
      "headers": {}
    }
  ]
}
`
